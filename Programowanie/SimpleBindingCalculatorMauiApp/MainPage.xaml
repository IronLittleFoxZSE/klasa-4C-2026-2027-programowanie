<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SimpleBindingCalculatorMauiApp.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="thisPage"
             BindingContext="{x:Reference thisPage}">

    <StackLayout Padding="30,0" Spacing="25">
        <Label Background="#E61B1B"
               BackgroundColor="#F7921B"
               FontAttributes="Bold"
               FontFamily="Arial"
               FontSize="20"
               Text="Podaj pierwszą liczbę" />
        <Entry Text="{Binding StrFirstNumber}" />
        <StackLayout Orientation="Horizontal">
            <Label Text="Podaj drugą liczbę" VerticalTextAlignment="Center" />
            <Entry BackgroundColor="Aqua" Text="{Binding StrSecondNumber}" />
        </StackLayout>
        <Button Clicked="Button_Clicked" Text="Oblicz" />
        <Label BackgroundColor="{Binding ReturnColor}"
               FontSize="30"
               Text="{Binding ResultMessage}" />
    </StackLayout>
</ContentPage>
